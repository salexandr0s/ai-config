{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000"
  },
  "attribution": {},
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "NotebookEdit",
      "EnterWorktree",
      "TeamCreate",
      "SendMessage",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean * -f*)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- .)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git restore -- .)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(sudo *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(diskutil eraseDisk *)",
      "Bash(diskutil eraseVolume *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(npm unpublish *)",
      "Bash(curl *| sh*)",
      "Bash(curl *| bash*)",
      "Bash(wget *| sh*)",
      "Bash(wget *| bash*)",
      "Bash(curl *|sh*)",
      "Bash(curl *|bash*)",
      "Bash(wget *|sh*)",
      "Bash(wget *|bash*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh",
    "padding": 1
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "outputStyle": "House Concise",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "frying potatoes",
      "kneading dough",
      "simmering the broth",
      "chopping onions",
      "whisking eggs",
      "seasoning the steak",
      "folding the batter",
      "caramelizing sugar",
      "blanching asparagus",
      "deglazing the pan",
      "rolling out pasta",
      "marinating chicken",
      "toasting spices",
      "reducing the sauce",
      "braising short ribs",
      "proofing the dough",
      "julienning carrots",
      "searing salmon",
      "tempering chocolate",
      "whipping cream",
      "roasting garlic",
      "pickling cucumbers",
      "glazing the ham",
      "mincing ginger",
      "basting the turkey",
      "flamb\u00e9ing cr\u00eapes",
      "infusing the oil",
      "poaching pears",
      "grilling corn",
      "zesting lemons",
      "rendering the fat",
      "salting the pasta water",
      "checking the seasoning",
      "resting the meat",
      "clarifying the butter",
      "blooming the spices",
      "scoring the bread",
      "laminating the dough",
      "skimming the stock",
      "pressing the tofu",
      "shucking the oysters",
      "deveining the shrimp",
      "torching the cr\u00e8me br\u00fbl\u00e9e",
      "peeling the tomatoes",
      "butterflying the lamb",
      "steaming the dumplings",
      "smoking the brisket",
      "clarifying the consomm\u00e9",
      "tempering the eggs",
      "brul\u00e9eing the sugar"
    ]
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/GitHub/ai-config/scripts/claude-pre-bash-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/GitHub/ai-config/scripts/version-check.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/GitHub/ai-config/scripts/check-freeze.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/GitHub/ai-config/scripts/hook-verification.py\" --agent claude pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/GitHub/ai-config/scripts/claude-post-edit.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/GitHub/ai-config/scripts/hook-verification.py\" --agent claude post",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/GitHub/ai-config/scripts/tab-title-update.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/GitHub/ai-config/scripts/claude-stop.sh\"",
            "timeout": 180
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "AI_NOTIFY_MIN_SECONDS=0 \"$HOME/GitHub/terminal-config/bin/ai-notify\" claude attention >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/GitHub/ai-config/scripts/claude-session-end.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
