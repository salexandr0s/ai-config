{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${XDG_CONFIG_HOME:-$HOME/.config}/ai-config/repo/scripts/codex-pre-bash-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Checking Bash command"
          }
        ]
      }
    ]
  }
}
